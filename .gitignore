# Local-only workspace. Notes, evidence, one-off results, and debug dumps stay on disk.
/.local/

# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
/.swc/

# production
/build

# typescript
*.tsbuildinfo
next-env.d.ts

# test caches
/coverage

# Playwright output. Root paths cover the default config.
# docs/testing/evidence covers master-run, remediation, screenshots, and downloads.
/test-results/
/playwright-report/
/blob-report/
/docs/testing/evidence/

# Old disposable-fixture path. Generators now write .local/testing/fixtures/.
# The generator scripts under tests/e2e/fixtures/ stay tracked.
/tests/e2e/fixtures/master/generated/

# Tesseract.js language caches downloaded into the repo root at runtime.
/*.traineddata

# local env files. .env.example is the committed placeholder and is not matched.
.env
.env*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# os and editor junk
.DS_Store
Thumbs.db
*.pem
